# 복사해서 .env로 사용하세요 (cp .env.example .env). .env는 Git에 올리지 않습니다.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=

# JWT 서명 키: 32자 이상 랜덤 문자열 (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

